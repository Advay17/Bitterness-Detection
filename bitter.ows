		<properties node_id="29" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x05*\x00\x00\x01\xc8\x00\x00\x08G\x00\x00\x03\xc7\x00\x00\x05+\x00\x00\x01\xe7\x00\x00\x08F\x00\x00\x03\xc6\x00\x00\x00\x00\x00\x00\x00\x00\rp\x00\x00\x05+\x00\x00\x01\xe7\x00\x00\x08F\x00\x00\x03\xc6', 'scriptLibrary': [{'name': 'New script', 'script': 'import Orange\n\ndata = in_data\nseqs = [str(row["seq"]) for row in data]\ntargets = [str(row["id"]) for row in data]\n\nalphabet = sorted(set(aa for seq in seqs for aa in seq))\nunique_targets = sorted(list(set(targets)))\n\ndomain = Orange.data.Domain(\n    [Orange.data.ContinuousVariable("sequence_id"),\n     Orange.data.DiscreteVariable("amino_acid", values=alphabet)],\n    class_vars=[Orange.data.DiscreteVariable("target", values=unique_targets)],\n    metas=[Orange.data.StringVariable("sequence")]\n)\n\nrows = []\nfor seq_id, (target, seq) in enumerate(zip(targets, seqs)):\n    for aa in seq:\n        rows.append([seq_id, aa, target, seq])\n\nout_data = Orange.data.Table.from_list(domain, rows)\n', 'filename': None}], 'scriptText': 'import Orange\n\ndata = in_data\nseqs = [str(row["seq"]) for row in data]\ntargets = [str(row["id"]) for row in data]\n\nalphabet = sorted(set(aa for seq in seqs for aa in seq))\nunique_targets = sorted(list(set(targets)))\n\ndomain = Orange.data.Domain(\n    [Orange.data.ContinuousVariable("sequence_id"),\n     Orange.data.DiscreteVariable("amino_acid", values=alphabet)],\n    class_vars=[Orange.data.DiscreteVariable("target", values=unique_targets)],\n    metas=[Orange.data.StringVariable("sequence")]\n)\n\nrows = []\nfor seq_id, (target, seq) in enumerate(zip(targets, seqs)):\n    for aa in seq:\n        rows.append([seq_id, aa, target, seq])\n\nout_data = Orange.data.Table.from_list(domain, rows)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa8\x00\x00\x00h\x01\xff\xff\xff\xff\x