		<properties node_id="9" format="literal">{'_session_items': [], '_session_items_v2': [({'type': 'AbsPath', 'path': 'C:/Users/kavin/Downloads/amino_acid_properties.csv'}, {'encoding': 'utf-8', 'delimiter': ',', 'quotechar': '"', 'doublequote': True, 'skipinitialspace': True, 'quoting': 0, 'columntypes': [{'start': 0, 'stop': 14, 'value': 'Auto'}], 'rowspec': [{'start': 0, 'stop': 1, 'value': 'Header'}], 'decimal_separator': '.', 'group_separator': ''}), ({'type': 'AbsPath', 'path': 'C:/Users/clockha2/Downloads/OneDrive_1_11-14-2025/amino_acid_properties.csv'}, {'encoding': 'utf-8', 'delimiter': ',', 'quotechar': '"', 'doublequote': True, 'skipinitialspace': True, 'quoting': 0, 'columntypes': [{'start': 0, 'stop': 14, 'value': 'Auto'}], 'rowspec': [{'start': 0, 'stop': 1, 'value': 'Header'}], 'decimal_separator': '.', 'group_separator': ''})], 'compatibility_mode': False, 'controlAreaVisible': True, 'dialog_state': {'directory': 'C:/Users/kavin/Downloads', 'filter': 'Text - comma separated (*.csv, *)'}, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x06-\x00\x00\x02\x1d\x00\x00\x07E\x00\x00\x03s\x00\x00\x06.\x00\x00\x02&lt;\x00\x00\x07D\x00\x00\x03r\x00\x00\x00\x00\x00\x00\x00\x00\rp\x00\x00\x06.\x00\x00\x02&lt;\x00\x00\x07D\x00\x00\x03r', '__version__': 3}</properties>
		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x05*\x00\x00\x01\xc8\x00\x00\x08G\x00\x00\x03\xc7\x00\x00\x05+\x00\x00\x01\xe7\x00\x00\x08F\x00\x00\x03\xc6\x00\x00\x00\x00\x00\x00\x00\x00\rp\x00\x00\x05+\x00\x00\x01\xe7\x00\x00\x08F\x00\x00\x03\xc6', 'scriptLibrary': [{'name': 'New script', 'script': 'import Orange\n\ndata = in_data\nseqs = [str(row["Peptides"]) for row in data]\ntargets = [str(row["Label"]) for row in data]\n\nalphabet = sorted(set(aa for seq in seqs for aa in seq))\nunique_targets = sorted(list(set(targets)))\n\ndomain = Orange.data.Domain(\n    [Orange.data.ContinuousVariable("sequence_id"),\n     Orange.data.DiscreteVariable("amino_acid", values=alphabet)],\n    class_vars=[Orange.data.DiscreteVariable("target", values=unique_targets)],\n    metas=[Orange.data.StringVariable("sequence")]\n)\n\nrows = []\nfor seq_id, (target, seq) in enumerate(zip(targets, seqs)):\n    for aa in seq:\n        rows.append([seq_id, aa, target, seq])\n\nout_data = Orange.data.Table.from_list(domain, rows)\n', 'filename': None}], 'scriptText': 'import Orange\n\ndata = in_data\nseqs = [str(row["Peptides"]) for row in data]\ntargets = [str(row["Label"]) for row in data]\n\nalphabet = sorted(set(aa for seq in seqs for aa in seq))\nunique_targets = sorted(list(set(targets)))\n\ndomain = Orange.data.Domain(\n    [Orange.data.ContinuousVariable("sequence_id"),\n     Orange.data.DiscreteVariable("amino_acid", values=alphabet)],\n    class_vars=[Orange.data.DiscreteVariable("target", values=unique_targets)],\n    metas=[Orange.data.StringVariable("sequence")]\n)\n\nrows = []\nfor seq_id, (target, seq) in enumerate(zip(targets, seqs)):\n    for aa in seq:\n        rows.append([seq_id, aa, target, seq])\n\nout_data = Orange.data.Table.from_list(domain, rows)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa8\x00\x00\x00h\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
